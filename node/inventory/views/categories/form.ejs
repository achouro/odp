<%- include('../partials/header') %>
<h2><%= title %></h2>

<% if (error_message) { %>
  <div class="alert"><%= error_message %></div>
<% } %>

<form action="<%= category.id ? '/categories/' + category.id + '/edit' : '/categories/new' %>" method="POST">
  <div class="form-group">
    <label for="name">Category Name</label>
    <input type="text" id="name" name="name" value="<%= category.name || '' %>" required>
  </div>
  <div class="form-group">
    <label for="description">Description</label>
    <textarea id="description" name="description" rows="3"><%= category.description || '' %></textarea>
  </div>

  <% if (category.id) { %>
    <div class="form-group" style="border-top: 1px solid #ddd; padding-top: 15px;">
      <label for="admin_password" style="color: #d9534f;">Admin Password Required to Save Changes</label>
      <input type="password" id="admin_password" name="admin_password" required placeholder="Enter admin password">
    </div>
  <% } %>

  <button type="submit" class="btn">Save Category</button>
  <a href="/categories" class="btn btn-secondary">Cancel</a>
</form>
<%- include('../partials/footer') %>