<%- include('../partials/header') %>
<h2>Delete Category: <%= category.name %></h2>
<p>Are you sure you want to delete <strong><%= category.name %></strong>? Deleting this category will delete all associated items due to cascading rules.</p>

<% if (error_message) { %>
  <div class="alert"><%= error_message %></div>
<% } %>

<form action="/categories/<%= category.id %>/delete" method="POST">
  <div class="form-group">
    <label for="admin_password" style="color: #d9534f;">Admin Password</label>
    <input type="password" id="admin_password" name="admin_password" required placeholder="Enter admin password">
  </div>
  <div class="actions">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a href="/categories/<%= category.id %>" class="btn btn-secondary">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>